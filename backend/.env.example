# ========================================================
# QuickShare Environment Configuration (Zero-Cost / Self-Hosted)
# ========================================================

# Server Configuration
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:5180

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Database Configuration:
# OPTION A: Zero-Config Local SQLite (Default, no setup required on Node 24+)
# Leaves DB_HOST / DATABASE_URL blank to automatically use native SQLite in database/quickshare.sqlite
SQLITE_DB_PATH=database/quickshare.sqlite

# OPTION B: MySQL / XAMPP / TiDB Serverless (Cloud MySQL)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=quickshare_db
# Or full connection URL (e.g., TiDB Serverless free cloud MySQL):
# DATABASE_URL=mysql://user:pass@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/quickshare_db?ssl={"rejectUnauthorized":true}

# Storage Configuration: 'local' (development) or 's3' (production Cloudflare R2 / Supabase Storage / AWS S3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# S3-Compatible Cloud Storage (Cloudflare R2, Supabase S3, AWS S3)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=quickshare-files

# Security, Quotas & Expiration
MAX_FILE_SIZE_MB=50
MAX_FILES_COUNT=10
DEFAULT_EXPIRY_HOURS=24
CLEANUP_CRON_SCHEDULE=*/15 * * * *

# ========================================================
# Real Email OTP Delivery via SMTP / Gmail App Password (100% Free)
# ========================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_gmail_app_password
# SMTP_FROM=QuickShare <no-reply@quickshare.local>

# Administrator Configuration (Confidential Private Console)
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=YourStrongAdminPassword2026!
# ADMIN_MFA_CODE=849201
